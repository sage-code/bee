+----------------------------
|  Demo Fibonacci rule      |
----------------------------+

-- declare Fibonacci rule
rule fib(n ∈ N) => (y ∈ N):
  if (n = 0) do
    let y := 0;
  else if (n = 1) do
    let y := 1;
  else
    let y := fib(n - 1) + fib(n - 2);
  done;
return;

rule main:
   -- call fib rule using argument 
   new r := fib(11);

   -- print the result to console
   print r;
return;
#end of module
