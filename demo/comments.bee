-- Style of comments
+-----------------------------------
| Bee has support for:             |
|   -- Single line comments        |
|   -- End of line comments        |
+----------------------------------+
-- entry point (line comment)
rule main:
  -- single line comment
  pass; -- end of line comment
  ...

-- comments in expressions
print ("comments     -- end of line
        are working  -- comments
        in strings"  -- are useful
        );
return;
